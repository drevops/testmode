+    /**
+     * @param \Symfony\Component\Console\Application $app
+     * @param \Symfony\Component\Console\Command\Command $command
+     */
+    protected static function addCommandToApplication($app, Command $command)
+    {
+        // Symfony Console < 7.4 has no addCommand(), and $app is not always a
+        // \Robo\Application with its own compatibility wrapper.
+        if (method_exists($app, 'addCommand')) {
+            $app->addCommand($command);
+            return;
+        }
+        $app->add($command);
+    }
